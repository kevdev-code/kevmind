{
  "description": "Benchmark only: the task's briefing as SessionStart context in the 'with' arm, nothing in the other",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
